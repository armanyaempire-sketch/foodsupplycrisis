---
/**
 * Food Supply Crisis ad loader.
 * Every unit below uses only the exact advertising code supplied
 * specifically for foodsupplycrisis.pages.dev.
 */
const { enabled = false } = Astro.props;

const ADS = {
  top: {
    desktop: { src: "/ads/728x90.html", w: 728, h: 90 },
    mobile: { src: "/ads/320x50.html", w: 320, h: 50 }
  },
  "inline-1": {
    desktop: { src: "/ads/300x250.html", w: 300, h: 250 },
    mobile: { src: "/ads/300x250.html", w: 300, h: 250 }
  },
  "inline-2": {
    desktop: { src: "/ads/300x250.html", w: 300, h: 250 },
    mobile: { src: "/ads/300x250.html", w: 300, h: 250 }
  },
  end: {
    desktop: { src: "/ads/468x60.html", w: 468, h: 60 },
    mobile: { src: "/ads/320x50.html", w: 320, h: 50 }
  },
  "home-1": {
    desktop: { src: "/ads/468x60.html", w: 468, h: 60 },
    mobile: { src: "/ads/320x50.html", w: 320, h: 50 }
  },
  "home-2": {
    desktop: { src: "/ads/728x90.html", w: 728, h: 90 },
    mobile: { src: "/ads/320x50.html", w: 320, h: 50 }
  },
  "home-hero": {
    desktop: { src: "/ads/300x250.html", w: 300, h: 250 },
    mobile: { src: "/ads/300x250.html", w: 300, h: 250 }
  },
  "sidebar-small": {
    desktop: { src: "/ads/160x300.html", w: 160, h: 300 },
    mobile: null
  },
  sidebar: {
    desktop: { src: "/ads/160x600.html", w: 160, h: 600 },
    mobile: null
  }
};
---

<style is:global>
  .ad-slot[data-slot],
  .native-ad-slot[data-native-ratio]{
    display:none;
  }
  .ad-slot{
    margin:2rem auto;
    text-align:center;
    max-width:100%;
    clear:both;
    overflow:hidden;
  }
  .ad-slot::before{
    content:"Advertisement";
    display:block;
    margin-bottom:6px;
    font:600 10px/1 system-ui,sans-serif;
    letter-spacing:.1em;
    text-transform:uppercase;
    opacity:.55;
  }
  .ad-slot[hidden],
  .native-ad-slot[hidden]{display:none}
  .ad-slot iframe{
    display:block;
    width:auto;
    max-width:100%;
    border:0;
    margin:0 auto;
  }
  .ad-slot[data-slot="sidebar"],
  .ad-slot[data-slot="sidebar-small"]{
    position:sticky;
    top:90px;
  }
  @media(max-width:1279px){
    .ad-slot[data-slot="sidebar"],
    .ad-slot[data-slot="sidebar-small"]{display:none}
  }
</style>

<script is:inline define:vars={{ ADS, enabled }}>
  (function(){
    if(!enabled){
      document.querySelectorAll(".ad-slot[data-slot], .native-ad-slot[data-native-ratio]").forEach(function(el){el.hidden=true;});
      return;
    }

    var desktopMQ=window.matchMedia("(min-width:768px)");

    function variantFor(name){
      var cfg=ADS[name];
      if(!cfg)return null;
      return desktopMQ.matches?cfg.desktop:cfg.mobile;
    }

    function mount(el,v,eager){
      var f=document.createElement("iframe");
      f.src=v.src;
      f.width=v.w;
      f.height=v.h;
      f.title="Advertisement";
      f.setAttribute("scrolling","no");
      f.setAttribute("frameborder","0");
      f.setAttribute("loading",eager?"eager":"lazy");
      f.style.width=v.w+"px";
      f.style.height=v.h+"px";
      f.style.maxWidth="100%";
      f.style.border="0";
      f.style.display="block";
      f.style.margin="0 auto";
      el.appendChild(f);
      el.setAttribute("data-ad-rendered","true");
    }

    function mountNative(el,src,w,h,eager){
      var f=document.createElement("iframe");
      f.src=src;
      f.width=w;
      f.height=h;
      f.title="Native Advertisement";
      f.setAttribute("scrolling","no");
      f.setAttribute("frameborder","0");
      f.setAttribute("loading",eager?"eager":"lazy");
      f.style.width=w+"px";
      f.style.height=h+"px";
      f.style.maxWidth="100%";
      f.style.border="0";
      f.style.display="block";
      f.style.margin="0 auto";
      el.querySelector(".native-ad-mount")?.appendChild(f);
      el.setAttribute("data-ad-rendered","true");
    }

    var io="IntersectionObserver" in window
      ? new IntersectionObserver(function(entries){
          entries.forEach(function(entry){
            if(!entry.isIntersecting)return;
            io.unobserve(entry.target);
            var v=variantFor(entry.target.dataset.slot);
            if(v)mount(entry.target,v,false);
          });
        },{rootMargin:"300px 0px"})
      : null;

    document.querySelectorAll(".ad-slot[data-slot]").forEach(function(el){
      var v=variantFor(el.dataset.slot);
      if(!v){el.hidden=true;return}
      el.style.minHeight=(v.h+16)+"px";
      if(el.dataset.slot==="home-hero")mount(el,v,true);
      else if(io)io.observe(el);
      else mount(el,v,false);
    });

    document.querySelectorAll(".native-ad-slot[data-native-ratio]").forEach(function(el){
      if(el.dataset.nativeMounted)return;
      el.dataset.nativeMounted="true";
      var ratio=el.dataset.nativeRatio;
      if(ratio==="4:1")mountNative(el,"/ads/native-4x1.html",640,160,true);
      else if(ratio==="1:4")mountNative(el,"/ads/native-1x4.html",160,600,true);
    });
  })();
</script>
