---
/**
 * AdLoader.astro — include ONCE in your base layout, just before </body>.
 *   import AdLoader from '../components/AdLoader.astro';
 *   <AdLoader />
 *
 * IMPORTANT: Ad credentials are site-specific. Do not copy a host or key
 * from another project. The homepage hero remains a 300×250 placeholder until
 * an Adsterra snippet explicitly provided for foodsupplycrisis.pages.dev is added.
 *
 * The hero unit loads eagerly once its site-specific credentials are configured.
 */
const HOST = 'YOUR_ADSTERRA_INVOKE_HOST'; // Must be provided specifically for foodsupplycrisis.pages.dev

const ADS = {
  top:       { desktop: { key: 'YOUR_KEY_728x90',  w: 728, h: 90  }, mobile: { key: 'YOUR_KEY_320x50',    w: 320, h: 50  } },
  'inline-1':{ desktop: { key: 'YOUR_KEY_300x250_A', w: 300, h: 250 }, mobile: { key: 'YOUR_KEY_300x250_A', w: 300, h: 250 } },
  'inline-2':{ desktop: { key: 'YOUR_KEY_300x250_B', w: 300, h: 250 }, mobile: { key: 'YOUR_KEY_300x250_B', w: 300, h: 250 } },
  end:       { desktop: { key: 'YOUR_KEY_728x90_END', w: 728, h: 90 }, mobile: { key: 'YOUR_KEY_300x250_C', w: 300, h: 250 } },
  'home-1':  { desktop: { key: 'YOUR_KEY_728x90_H1', w: 728, h: 90 }, mobile: { key: 'YOUR_KEY_300x250_H1', w: 300, h: 250 } },
  'home-2':  { desktop: { key: 'YOUR_KEY_728x90_H2', w: 728, h: 90 }, mobile: { key: 'YOUR_KEY_300x250_H2', w: 300, h: 250 } },
  'home-hero': { desktop: { key: 'YOUR_KEY_300x250_FOODSUPPLY', w: 300, h: 250 }, mobile: { key: 'YOUR_KEY_300x250_FOODSUPPLY', w: 300, h: 250 } },
  sidebar:   { desktop: { key: 'YOUR_KEY_160x600', w: 160, h: 600 }, mobile: null },
};
---

<style is:global>
  .ad-slot { margin: 2rem auto; text-align: center; max-width: 100%; clear: both; overflow: hidden; }
  .ad-slot::before {
    content: 'Advertisement'; display: block; margin-bottom: 6px;
    font: 600 10px/1 system-ui, sans-serif; letter-spacing: .1em; text-transform: uppercase; opacity: .55;
  }
  .ad-slot[hidden] { display: none; }
  .ad-slot iframe { border: 0; max-width: 100%; display: block; margin: 0 auto; }
  .ad-slot .ad-dev,
  .ad-slot .ad-unconfigured {
    border: 1px solid rgba(18,34,53,.16);
    background: linear-gradient(135deg,#f6f8f5 0%,#eef4f0 100%);
    color: #667585;
    display: grid;
    place-items: center;
    gap: 5px;
    font: 700 12px/1.35 system-ui, sans-serif;
    margin: 0 auto;
  }
  .ad-slot .ad-unconfigured span {
    display: block;
  }
  .ad-slot .ad-unconfigured small {
    display: block;
    font: 600 10px/1.2 system-ui, sans-serif;
    opacity: .8;
  }
  .ad-slot[data-slot="sidebar"] { position: sticky; top: 90px; }
  @media (max-width: 1279px) { .ad-slot[data-slot="sidebar"] { display: none; } }
</style>

<script is:inline define:vars={{ HOST, ADS }}>
  (function () {
    var isDev = /^(localhost|127\\.0\\.0\\.1)$/.test(location.hostname);
    var desktopMQ = window.matchMedia('(min-width: 768px)');

    function variantFor(slotName) {
      var cfg = ADS[slotName];
      if (!cfg) return null;
      var v = desktopMQ.matches ? cfg.desktop : cfg.mobile;
      return v || null;
    }

    function configured(v) {
      return !!(v && v.key && v.key.indexOf('YOUR_') !== 0 && HOST.indexOf('YOUR_') !== 0);
    }

    function mount(el, v, eager) {
      var f = document.createElement('iframe');
      f.width = v.w;
      f.height = v.h;
      f.title = 'Advertisement';
      f.setAttribute('scrolling', 'no');
      f.setAttribute('loading', eager ? 'eager' : 'lazy');
      f.srcdoc = '<!doctype html><html><body style="margin:0">' +
        '<script>atOptions={"key":"' + v.key + '","format":"iframe","height":' + v.h + ',"width":' + v.w + ',"params":{}};<\\/script>' +
        '<script src="//' + HOST + '/' + v.key + '/invoke.js"><\\/script></body></html>';
      el.appendChild(f);
    }

    function showPlaceholder(el, v) {
      var d = document.createElement('div');
      d.className = 'ad-unconfigured';
      d.style.width = v.w + 'px';
      d.style.maxWidth = '100%';
      d.style.height = v.h + 'px';
      d.innerHTML = '<span>' + v.w + ' × ' + v.h + ' ad slot</span><small>Adsterra placement ready</small>';
      el.appendChild(d);
      el.setAttribute('data-ad-status', 'unconfigured');
    }

    var io = 'IntersectionObserver' in window ? new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        var v = variantFor(e.target.dataset.slot);
        if (configured(v)) mount(e.target, v, false);
      });
    }, { rootMargin: '300px 0px' }) : null;

    document.querySelectorAll('.ad-slot[data-slot]').forEach(function (el) {
      var v = variantFor(el.dataset.slot);
      if (!v) {
        el.hidden = true;
        return;
      }

      if (!configured(v)) {
        if (isDev) {
          showPlaceholder(el, v);
        } else if (el.dataset.slot === 'home-hero') {
          showPlaceholder(el, v);
        } else {
          el.hidden = true;
        }
        return;
      }

      el.style.minHeight = (v.h + 16) + 'px';
      if (io) io.observe(el); else mount(el, v);
    });
  })();
</script>
