---
interface Props {
  placement:
    | "native-horizontal"
    | "native-vertical"
    | "banner-300x250"
    | "banner-160x600"
    | "banner-160x300"
    | "responsive-banner"
    | "smartlink";
}

const { placement } = Astro.props;
const responsiveId = "ad-responsive-" + placement;
---

{placement === "responsive-banner" && (
  <div class="ad-frame ad-responsive-shell" aria-label="Advertisement">
    <span class="ad-label">Advertisement</span>
    <div id={responsiveId} class="ad-responsive-target"></div>
    <script is:inline define:vars={{ responsiveId }}>
      (() => {
        const root = document.getElementById(responsiveId);
        if (!root || root.dataset.loaded) return;
        root.dataset.loaded = "true";

        const width = window.innerWidth;
        let key;
        let height;
        let bannerWidth;

        if (width <= 600) {
          key = "f3f2a864e3d1b573f35f44db68299cb3";
          height = 50;
          bannerWidth = 320;
        } else if (width <= 900) {
          key = "80ec5671003b40ab7d6cba7e8e0ff7d7";
          height = 60;
          bannerWidth = 468;
        } else {
          key = "c4991b14b1a406d961cfe610cb1fcb2e";
          height = 90;
          bannerWidth = 728;
        }

        window.atOptions = {
          key,
          format: "iframe",
          height,
          width: bannerWidth,
          params: {}
        };

        const script = document.createElement("script");
        script.src = "https://disregardpervertmural.com/" + key + "/invoke.js";
        script.async = false;
        root.appendChild(script);
      })();
    </script>
  </div>
)}

{placement === "native-horizontal" && (
  <div class="ad-frame ad-native ad-native-horizontal" aria-label="Advertisement">
    <span class="ad-label">Advertisement</span>
    <script async="async" data-cfasync="false" src="https://disregardpervertmural.com/10619e4f398ca4ebaa8f1fee1177a9ab/invoke.js"></script>
    <div id="container-10619e4f398ca4ebaa8f1fee1177a9ab"></div>
  </div>
)}

{placement === "native-vertical" && (
  <div class="ad-frame ad-native ad-native-vertical" aria-label="Advertisement">
    <span class="ad-label">Advertisement</span>
    <script async="async" data-cfasync="false" src="https://disregardpervertmural.com/10619e4f398ca4ebaa8f1fee1177a9ab/invoke.js"></script>
    <div id="container-10619e4f398ca4ebaa8f1fee1177a9ab"></div>
  </div>
)}

{placement === "banner-300x250" && (
  <div class="ad-frame ad-box-300" aria-label="Advertisement">
    <span class="ad-label">Advertisement</span>
    <script is:inline>
      atOptions = {
        key: "21b2baf520df7218cf46936081c66fba",
        format: "iframe",
        height: 250,
        width: 300,
        params: {}
      };
    </script>
    <script is:inline src="https://disregardpervertmural.com/21b2baf520df7218cf46936081c66fba/invoke.js"></script>
  </div>
)}

{placement === "banner-160x600" && (
  <div class="ad-frame ad-box-160 ad-tall" aria-label="Advertisement">
    <span class="ad-label">Advertisement</span>
    <script is:inline>
      atOptions = {
        key: "39cfc9f3acd6df7af5eab9fbec1ce52e",
        format: "iframe",
        height: 600,
        width: 160,
        params: {}
      };
    </script>
    <script is:inline src="https://disregardpervertmural.com/39cfc9f3acd6df7af5eab9fbec1ce52e/invoke.js"></script>
  </div>
)}

{placement === "banner-160x300" && (
  <div class="ad-frame ad-box-160 ad-medium-tall" aria-label="Advertisement">
    <span class="ad-label">Advertisement</span>
    <script is:inline>
      atOptions = {
        key: "996af7817408d597f6bb2012e37c8ae4",
        format: "iframe",
        height: 300,
        width: 160,
        params: {}
      };
    </script>
    <script is:inline src="https://disregardpervertmural.com/996af7817408d597f6bb2012e37c8ae4/invoke.js"></script>
  </div>
)}

{placement === "smartlink" && (
  <div class="ad-smartlink-wrap">
    <span class="ad-label">Sponsored</span>
    <a
      class="ad-smartlink"
      href="https://disregardpervertmural.com/u069a96wn6?key=992c6187a83a0f0d0816922084c5da5c"
      rel="sponsored nofollow noopener"
      target="_blank"
    >
      Explore a sponsored resource →
    </a>
  </div>
)}
