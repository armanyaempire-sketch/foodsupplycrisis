---
import { SITE } from "../config/site";
import { getCountryFlag } from "../utils/country-flags";

interface Props {
  article: {
    id: string;
    data: {
      title: string;
      description: string;
      category: string;
      pubDate: Date;
      heroImage?: string;
      imageAlt?: string;
      type?: string;
    };
  };
  featured?: boolean;
}

const { article, featured = false } = Astro.props;
const flag = getCountryFlag(article.data.title);
const image = article.data.heroImage ?? flag?.url ?? SITE.defaultImage;
const imageAlt = article.data.imageAlt ?? (flag ? `${flag.name} national flag` : article.data.title);
---

<article class:list={["card", featured && "card-featured"]}>
  <a class="card-image-link" href={`/articles/${article.id}/`} aria-label={`Read: ${article.data.title}`}>
    <img class="card-image" src={image} alt={imageAlt} width="1200" height="675" loading="lazy" decoding="async" />
  </a>
  <p class="eyebrow">{article.data.category}</p>
  <h2><a href={`/articles/${article.id}/`}>{article.data.title}</a></h2>
  <p>{article.data.description}</p>
  <div class="card-meta">
    <span>{article.data.type ?? "analysis"}</span>
    <span>{article.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</span>
  </div>
  <a class="card-read" href={`/articles/${article.id}/`}>Read the analysis →</a>
</article>
