---
import BaseLayout from "./BaseLayout.astro";
import AdPlacement from "../components/AdPlacement.astro";
import { SITE } from "../config/site";

interface Source {
  name: string;
  url: string;
}

interface RelatedArticle {
  title: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  category: string;
  keywords: string[];
  sources: Source[];
  related?: RelatedArticle[];
  image?: string;
  imageAlt?: string;
  contentType?: "analysis" | "explainer" | "news";
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  category,
  keywords,
  sources,
  related = [],
  image = SITE.defaultImage,
  imageAlt = title,
  contentType = "analysis"
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).toString();

const categorySlug = category.toLowerCase()
  .replace(/&/g, "and")
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-|-$/g, "");

const categoryPaths: Record<string, string> = {
  "Global Food Crisis": "/global-food-crisis/",
  "Food Prices": "/food-prices/",
  "Food Supply": "/food-supply/",
  "Food Security": "/food-security/",
  "Countries": "/countries/",
  "Climate & Agriculture": "/climate-agriculture/",
  "Water & Food": "/water-food/",
  "Fertilizer": "/fertilizer/",
  "Supply Chains": "/supply-chain/",
  "Food Storage": "/food-storage/",
  "Solutions": "/solutions/"
};

const categoryUrl = categoryPaths[category] ?? "/categories/" + categorySlug + "/";
const schemaType = contentType === "news" ? "NewsArticle" : "Article";

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": schemaType,
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    "@type": "Organization",
    name: author,
    url: new URL("/about/editorial-desk/", SITE.url).toString()
  },
  publisher: {
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url,
    logo: {
      "@type": "ImageObject",
      url: new URL("/favicon.svg", SITE.url).toString()
    }
  },
  mainEntityOfPage: canonical,
  keywords,
  image: [new URL(image, SITE.url).toString()]
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  type="article"
  image={image}
  publishedTime={pubDate}
  modifiedTime={updatedDate ?? pubDate}
  authorName={author}
  adProfile="article"
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: category, url: categoryUrl },
    { name: title, url: canonical }
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />

  <article class="article-shell">
    <div class="article-main">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href={categoryUrl}>{category}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>

      <p class="eyebrow">{category}</p>
      <h1>{title}</h1>
      <p class="article-dek">{description}</p>

      <div class="article-meta">
        <span>By {author}</span>
        <span>Published {pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</span>
        {updatedDate && <span>Updated {updatedDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</span>}
      </div>

      {image !== SITE.defaultImage && (
        <figure class="article-hero">
          <img src={image} alt={imageAlt} width="1600" height="900" loading="eager" decoding="async" />
        </figure>
      )}

      <div class="article-content">
        <slot />
      </div>

      {related.length > 0 && (
        <section class="section related-section" aria-labelledby="related-heading">
          <h2 id="related-heading">Related Food Supply Coverage</h2>
          <div class="card-grid">
            {related.map((item) => (
              <article class="card">
                <h3><a href={item.url}>{item.title}</a></h3>
              </article>
            ))}
          </div>
        </section>
      )}

      <section class="source-box" aria-labelledby="sources-heading">
        <h2 id="sources-heading">Sources & Further Reading</h2>
        <p>Important figures, forecasts and current-event claims should be checked against the original material linked below.</p>
        <ul>
          {sources.map((source) => (
            <li><a href={source.url} rel="noopener noreferrer" target="_blank">{source.name}</a></li>
          ))}
        </ul>
      </section>
    </div>

    <aside class="article-sidebar" aria-label="Article advertising and related information">
      <AdPlacement placement="native-vertical" />

      <div class="sidebar-ad-block">
        <AdPlacement placement="banner-300x250" />
      </div>

      <div class="sidebar-ad-block desktop-tall-ad">
        <AdPlacement placement="banner-160x600" />
      </div>

      <div class="sidebar-ad-block medium-tall-ad">
        <AdPlacement placement="banner-160x300" />
      </div>

      <div class="sidebar-card">
        <h2>Evidence matters</h2>
        <p>We distinguish observed data, official forecasts, reported events and analysis.</p>
      </div>
    </aside>
  </article>
</BaseLayout>
