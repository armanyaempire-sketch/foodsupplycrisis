---
import BaseLayout from "./BaseLayout.astro";
import { SITE } from "../config/site";

interface Source {
  name: string;
  url: string;
}

interface RelatedArticle {
  title: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  category: string;
  keywords: string[];
  sources: Source[];
  related?: RelatedArticle[];
  image?: string;
  imageAlt?: string;
  contentType?: "analysis" | "explainer" | "news";
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  category,
  keywords,
  sources,
  related = [],
  image = SITE.defaultImage,
  imageAlt = title,
  contentType = "analysis"
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).toString();

const flagForArticle = (title: string) => {
  const t = title.toLowerCase();

  const flags = [
    { match: ["united states", "us food", "u.s. food", "american"], code: "us", name: "United States" },
    { match: ["india"], code: "in", name: "India" },
    { match: ["china"], code: "cn", name: "China" },
    { match: ["egypt"], code: "eg", name: "Egypt" },
    { match: ["philippines"], code: "ph", name: "Philippines" },
    { match: ["nigeria", "borno"], code: "ng", name: "Nigeria" },
    { match: ["japan rice", "japan"], code: "jp", name: "Japan" },
    { match: ["brazil"], code: "br", name: "Brazil" },
    { match: ["australia"], code: "au", name: "Australia" },
    { match: ["bangladesh"], code: "bd", name: "Bangladesh" },
    { match: ["pakistan"], code: "pk", name: "Pakistan" },
    { match: ["turkey", "turkiye"], code: "tr", name: "Türkiye" },
    { match: ["germany"], code: "de", name: "Germany" },
    { match: ["indonesia", "southeast asia rice"], code: "id", name: "Indonesia" },
    { match: ["thailand"], code: "th", name: "Thailand" },
    { match: ["sudan"], code: "sd", name: "Sudan" },
    { match: ["yemen"], code: "ye", name: "Yemen" },
    { match: ["somalia"], code: "so", name: "Somalia" },
    { match: ["uk", "united kingdom", "britain"], code: "gb", name: "United Kingdom" }
  ];

  const match = flags.find((flag) => flag.match.some((term) => t.includes(term)));
  return match
    ? {
        ...match,
        url: `https://flagcdn.com/w1600/${match.code}.png`
      }
    : null;
};

const detectedFlag = image === SITE.defaultImage ? flagForArticle(title) : null;
const featuredImage = detectedFlag?.url ?? image;
const featuredImageAlt = detectedFlag ? `${detectedFlag.name} national flag` : imageAlt;

const categorySlug = category.toLowerCase()
  .replace(/&/g, "and")
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-|-$/g, "");

const categoryPaths: Record<string, string> = {
  "Global Food Crisis": "/global-food-crisis/",
  "Food Prices": "/food-prices/",
  "Food Supply": "/food-supply/",
  "Food Security": "/food-security/",
  "Countries": "/countries/",
  "Climate & Agriculture": "/climate-agriculture/",
  "Water & Food": "/water-food/",
  "Fertilizer": "/fertilizer/",
  "Supply Chains": "/supply-chain/",
  "Food Storage": "/food-storage/",
  "Solutions": "/solutions/"
};

const categoryUrl = categoryPaths[category] ?? "/categories/" + categorySlug + "/";
const schemaType = contentType === "news" ? "NewsArticle" : "Article";

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": schemaType,
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    "@type": "Organization",
    name: author,
    url: new URL("/about/editorial-desk/", SITE.url).toString()
  },
  publisher: {
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url,
    logo: {
      "@type": "ImageObject",
      url: new URL("/favicon.svg", SITE.url).toString()
    }
  },
  mainEntityOfPage: canonical,
  keywords,
  image: [new URL(featuredImage, SITE.url).toString()]
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  type="article"
  image={featuredImage}
  publishedTime={pubDate}
  modifiedTime={updatedDate ?? pubDate}
  authorName={author}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: category, url: categoryUrl },
    { name: title, url: canonical }
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />

  <article class="article-shell">
    <div class="article-main article-reading-column">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href={categoryUrl}>{category}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>

      <div class="article-category-badge"><span class="article-category-dot" aria-hidden="true"></span>{category}</div>
      <h1>{title}</h1>
      <p class="article-dek">{description}</p>

      <div class="article-meta">
        <span>By {author}</span>
        <span>Published {pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</span>
        {updatedDate && <span>Updated {updatedDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</span>}
      </div>

      {featuredImage !== SITE.defaultImage && (
        <figure class="article-hero article-flag-hero">
          <img src={featuredImage} alt={featuredImageAlt} width="1600" height="900" loading="eager" decoding="async" />
        </figure>
      )}

      <div class="article-content">
        <slot />
      </div>

      {related.length > 0 && (
        <section class="section related-section" aria-labelledby="related-heading">
          <h2 id="related-heading">Related Food Supply Coverage</h2>
          <div class="card-grid">
            {related.map((item) => (
              <article class="card">
                <h3><a href={item.url}>{item.title}</a></h3>
              </article>
            ))}
          </div>
        </section>
      )}

      <section class="source-box source-box-primary" aria-labelledby="sources-heading">
        <h2 id="sources-heading">Sources & Further Reading</h2>
        <p>Important figures, forecasts and current-event claims should be checked against the original material linked below.</p>
        <ul>
          {sources.map((source) => (
            <li><a href={source.url} rel="noopener noreferrer" target="_blank">{source.name}</a></li>
          ))}
        </ul>
      </section>
    </div>
  </article>
</BaseLayout>
