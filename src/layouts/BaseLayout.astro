---
import { SITE } from "../config/site";
import AdLoader from "../components/AdLoader.astro";
import PrivacyConsent from "../components/PrivacyConsent.astro";
import AdSlot from "../components/AdSlot.astro";
import NativeAdSlot from "../components/NativeAdSlot.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  authorName?: string;
  breadcrumbs?: Array<{ name: string; url: string }>;
  showAds?: boolean;
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, SITE.url).toString(),
  noindex = false,
  image = SITE.defaultImage,
  type = "website",
  publishedTime,
  modifiedTime,
  authorName = SITE.authorName,
  breadcrumbs = [],
  showAds = true,
} = Astro.props;

const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;

const absoluteImage = image.startsWith("http") ? image : new URL(image, SITE.url).toString();
const canonicalUrl = canonical.endsWith("/") ? canonical : canonical + "/";

const currentPath = Astro.url.pathname;
const isHomePage = currentPath === "/";
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  alternateName: SITE.shortName,
  url: SITE.url,
  description: SITE.description,
  inLanguage: "en"
};

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.name,
  url: SITE.url,
  logo: new URL("/favicon.svg", SITE.url).toString()
};

const breadcrumbJsonLd = breadcrumbs.length
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.name,
        item: new URL(item.url, SITE.url).toString()
      }))
    }
  : null;
---

<html lang="en">
  <head>
    <script is:inline>
      (function () {
        const GA_ID = "G-EN1K0Q5XTB";
        const CONSENT_KEY = "fsc_analytics_consent";
        let loaded = false;

        function loadAnalytics() {
          if (loaded) return;
          let consent = null;
          try { consent = localStorage.getItem(CONSENT_KEY); } catch {}
          if (consent !== "granted") return;

          loaded = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
          window.gtag("js", new Date());
          window.gtag("config", GA_ID);

          const script = document.createElement("script");
          script.async = true;
          script.src = "https://www.googletagmanager.com/gtag/js?id=" + GA_ID;
          document.head.appendChild(script);
        }

        window.addEventListener("fsc:analytics-consent", function (event) {
          if (event.detail === "granted") loadAnalytics();
        });

        loadAnalytics();
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#123c35" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="google-site-verification" content="ENViJVJLLA4VH_FH9dZ8kABAqV8tldQadYiNu0oMGAU" />
    <meta name="google-adsense-account" content="ca-pub-4245594685213859" />

    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />

    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {type === "article" && <meta property="article:author" content={authorName} />}

    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    {breadcrumbJsonLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />}
    <title>{title}</title>
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label={SITE.name}>
          <span class="brand-mark" aria-hidden="true">FS</span>
          <span class="brand-copy">
            <strong>{SITE.name}</strong>
            <small>{SITE.tagline}</small>
          </span>
        </a>

        <div class="header-status" aria-label="Publication focus">
          <span class="header-status-dot" aria-hidden="true"></span>
          <span>Evidence-led reporting</span>
        </div>

        <button class="mobile-menu-button" type="button" aria-expanded="false" aria-controls="mobile-navigation">
          <span class="mobile-menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>Menu</span>
        </button>
      </div>
    </header>

    {showAds && <div class:list={["site-top-ad", isHomePage && "home-top-ad"]} aria-label="Advertisement"><AdSlot slot="top" /></div>}

    <div class="mobile-menu-layer" data-mobile-menu>
      <button class="mobile-menu-backdrop" type="button" aria-label="Close menu" data-mobile-menu-close></button>
      <nav id="mobile-navigation" class="mobile-drawer" aria-label="Mobile primary navigation" aria-hidden="true">
        <div class="mobile-drawer-header">
          <div>
            <span>Browse</span>
            <small>Food Supply Crisis</small>
          </div>
          <button class="mobile-drawer-close" type="button" aria-label="Close menu" data-mobile-menu-close>&times;</button>
        </div>
        <div class="mobile-drawer-links">
          <a class={isActive("/") ? "is-active" : ""} href="/"><span class="mobile-nav-icon" aria-hidden="true">⌂</span><span>Home</span></a>
          <a class={isActive("/global-food-crisis/") ? "is-active" : ""} href="/global-food-crisis/"><span class="mobile-nav-icon" aria-hidden="true">◎</span><span>Global Crisis</span></a>
          <a class={isActive("/food-prices/") ? "is-active" : ""} href="/food-prices/"><span class="mobile-nav-icon" aria-hidden="true">$</span><span>Food Prices</span></a>
          <a class={isActive("/food-supply/") ? "is-active" : ""} href="/food-supply/"><span class="mobile-nav-icon" aria-hidden="true">↔</span><span>Food Supply</span></a>
          <a class={isActive("/food-security/") ? "is-active" : ""} href="/food-security/"><span class="mobile-nav-icon" aria-hidden="true">✓</span><span>Food Security</span></a>
          <a class={isActive("/countries/") ? "is-active" : ""} href="/countries/"><span class="mobile-nav-icon" aria-hidden="true">◌</span><span>Countries</span></a>
          <a class={isActive("/climate-agriculture/") ? "is-active" : ""} href="/climate-agriculture/"><span class="mobile-nav-icon" aria-hidden="true">☁</span><span>Climate &amp; Crops</span></a>
          <a class={isActive("/fertilizer/") ? "is-active" : ""} href="/fertilizer/"><span class="mobile-nav-icon" aria-hidden="true">✦</span><span>Fertilizer</span></a>
          <a class={isActive("/solutions/") ? "is-active" : ""} href="/solutions/"><span class="mobile-nav-icon" aria-hidden="true">→</span><span>Solutions</span></a>
        </div>
      </nav>
    </div>

    <div class={"site-shell shell" + (type === "article" ? " article-layout" : "")}>
      
      <button class="desktop-menu-toggle" type="button" aria-expanded="true" aria-controls="desktop-navigation">
      <span class="desktop-menu-toggle-icon" aria-hidden="true">☰</span>
      <span class="desktop-menu-toggle-text">Menu</span>
    </button>

    <div class="desktop-menu-layer" data-desktop-menu>
      <button class="desktop-menu-backdrop" type="button" aria-label="Close navigation" data-desktop-menu-close></button>
      <aside class="site-sidebar" id="desktop-navigation" aria-label="Site navigation" aria-hidden="false">
        <div class="sidebar-card">
          <div class="sidebar-card-header">
            <div>
              <div class="sidebar-label">Explore the site</div>
              <span class="sidebar-kicker">Food Supply Crisis</span>
            </div>
            <button class="sidebar-close" type="button" aria-label="Close navigation" data-desktop-menu-close>&times;</button>
          </div>
          <nav class="sidebar-nav" aria-label="Desktop primary navigation">
            <a class={isActive("/") ? "is-active sidebar-home" : "sidebar-home"} href="/">
              <span class="sidebar-icon" aria-hidden="true">⌂</span><span>Home</span>
            </a>
            <a class={isActive("/global-food-crisis/") ? "is-active" : ""} href="/global-food-crisis/">
              <span class="sidebar-icon" aria-hidden="true">◎</span><span>Global Crisis</span>
            </a>
            <a class={isActive("/food-prices/") ? "is-active" : ""} href="/food-prices/">
              <span class="sidebar-icon" aria-hidden="true">$</span><span>Food Prices</span>
            </a>
            <a class={isActive("/food-supply/") ? "is-active" : ""} href="/food-supply/">
              <span class="sidebar-icon" aria-hidden="true">↔</span><span>Food Supply</span>
            </a>
            <a class={isActive("/food-security/") ? "is-active" : ""} href="/food-security/">
              <span class="sidebar-icon" aria-hidden="true">✓</span><span>Food Security</span>
            </a>
            <a class={isActive("/countries/") ? "is-active" : ""} href="/countries/">
              <span class="sidebar-icon" aria-hidden="true">◌</span><span>Countries</span>
            </a>
            <a class={isActive("/climate-agriculture/") ? "is-active" : ""} href="/climate-agriculture/">
              <span class="sidebar-icon" aria-hidden="true">☁</span><span>Climate &amp; Crops</span>
            </a>
            <a class={isActive("/fertilizer/") ? "is-active" : ""} href="/fertilizer/">
              <span class="sidebar-icon" aria-hidden="true">✦</span><span>Fertilizer</span>
            </a>
            <a class={isActive("/solutions/") ? "is-active" : ""} href="/solutions/">
              <span class="sidebar-icon" aria-hidden="true">→</span><span>Solutions</span>
            </a>
          </nav>
          <div class="sidebar-note">
            <strong>Follow the story</strong>
            <p>Track prices, supply risks, climate pressures and practical responses in one place.</p>
          </div>
        </div>
      </aside>
    </div>

      <main id="main-content" class="site-main">
        <slot />
      </main>

      {showAds && type === "article" && (
        <aside class="article-side-ad" aria-label="Advertisement">
          <NativeAdSlot ratio="1:4" />
          <AdSlot slot="sidebar" />
        </aside>
      )}
    </div>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-brand">
          <div class="footer-brand-row">
            <span class="brand-mark" aria-hidden="true">FS</span>
            <strong>{SITE.name}</strong>
          </div>
          <p>{SITE.description}</p>
          <span class="footer-kicker">What’s Happening. Why It Matters. What Can Be Done.</span>
        </div>

        <div>
          <p class="footer-heading">Explore</p>
          <div class="footer-links">
            <a href="/global-food-crisis/">Global Crisis</a>
            <a href="/food-supply/">Food Supply</a>
            <a href="/food-prices/">Food Prices</a>
            <a href="/food-security/">Food Security</a>
            <a href="/countries/">Countries</a>
            <a href="/climate-agriculture/">Climate &amp; Agriculture</a>
            <a href="/fertilizer/">Fertilizer</a>
            <a href="/solutions/">Solutions</a>
          </div>
        </div>

        <div>
          <p class="footer-heading">Publication</p>
          <div class="footer-links footer-links-single">
            <a href="/about/">About</a>
            <a href="/about/editorial-desk/">Editorial Desk</a>
            <a href="/editorial-policy/">Editorial Policy</a>
            <a href="/sources/">Sources</a>
            <a href="/contact/">Contact</a>
            <a href="/privacy-policy/">Privacy Policy</a>
            <a href="/disclaimer/">Disclaimer</a>
            <a href="https://disregardpervertmural.com/u069a96wn6?key=992c6187a83a0f0d0816922084c5da5c" target="_blank" rel="sponsored nofollow noopener noreferrer">Sponsored link</a>
          </div>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} {SITE.name}</span>
        <span>Evidence-led global food-supply reporting.</span>
      </div>
    </footer>
    <PrivacyConsent />
    <script>
      const menuLayer = document.querySelector("[data-mobile-menu]");
      const menuButton = document.querySelector(".mobile-menu-button");
      const mobileDrawer = document.getElementById("mobile-navigation");
      const closeButtons = document.querySelectorAll("[data-mobile-menu-close]");

      const setMobileMenu = (open) => {
        if (!menuLayer || !menuButton || !mobileDrawer) return;
        menuLayer.classList.toggle("is-open", open);
        menuButton.setAttribute("aria-expanded", String(open));
        mobileDrawer.setAttribute("aria-hidden", String(!open));
        document.body.classList.toggle("mobile-menu-open", open);
        if (open) mobileDrawer.querySelector("a")?.focus();
        else menuButton.focus();
      };

      menuButton?.addEventListener("click", () => setMobileMenu(true));
      closeButtons.forEach((button) => button.addEventListener("click", () => {
        if (button.closest(".desktop-menu-layer")) setDesktopMenu(false);
        else setMobileMenu(false);
      }));
      mobileDrawer?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMobileMenu(false)));

      const desktopLayer = document.querySelector("[data-desktop-menu]");
      const desktopButton = document.querySelector(".desktop-menu-toggle");
      const desktopAside = document.getElementById("desktop-navigation");
      const desktopCloseButtons = document.querySelectorAll("[data-desktop-menu-close]");

      const setDesktopMenu = (open) => {
        if (!desktopLayer || !desktopButton || !desktopAside) return;
        desktopLayer.classList.toggle("is-open", open);
        desktopButton.classList.toggle("is-hidden", open);
        desktopButton.setAttribute("aria-expanded", String(open));
        desktopAside.setAttribute("aria-hidden", String(!open));
        document.body.classList.toggle("desktop-menu-open", open);
        if (open) desktopAside.querySelector("a")?.focus();
        else desktopButton.focus();
      };

      desktopButton?.addEventListener("click", () => setDesktopMenu(true));
      desktopCloseButtons.forEach((button) => button.addEventListener("click", () => setDesktopMenu(false)));
      desktopAside?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setDesktopMenu(false)));

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          setDesktopMenu(false);
          setMobileMenu(false);
        }
      });
    </script>
    {showAds && <AdLoader />}
  </body>
</html>
