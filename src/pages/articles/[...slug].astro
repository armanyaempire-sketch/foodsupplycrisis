---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");

  return articles.map((article) => {
    const stopWords = new Set([
      "a", "an", "and", "are", "as", "at", "by", "for", "from", "how",
      "in", "is", "it", "of", "on", "or", "the", "to", "what", "when",
      "why", "with", "2026", "2027", "food", "foods", "global", "crisis",
      "prices", "price", "risk", "supply", "security", "outlook", "impact",
      "guide", "explained", "data", "shortage"
    ]);

    const keywordTokens = (values: string[]) =>
      new Set(
        values
          .join(" ")
          .toLowerCase()
          .replace(/[^a-z0-9\\s-]/g, " ")
          .split(/\\s+/)
          .map((word) => word.trim())
          .filter((word) => word.length > 2 && !stopWords.has(word))
      );

    const articleTerms = keywordTokens([
      article.data.primaryKeyword,
      ...article.data.keywords
    ]);

    const related = articles
      .filter((candidate) => candidate.id !== article.id)
      .map((candidate) => {
        const candidateTerms = keywordTokens([
          candidate.data.primaryKeyword,
          ...candidate.data.keywords
        ]);
        const sharedTerms = [...candidateTerms].filter((term) => articleTerms.has(term));
        const sameCategory = candidate.data.category === article.data.category;

        return {
          candidate,
          score: sharedTerms.length * 10 + (sameCategory && sharedTerms.length > 0 ? 2 : 0)
        };
      })
      .filter(({ score }) => score >= 10)
      .sort((a, b) =>
        b.score - a.score ||
        b.candidate.data.pubDate.valueOf() - a.candidate.data.pubDate.valueOf()
      )
      .slice(0, 3)
      .map(({ candidate }) => ({
        title: candidate.data.title,
        url: `/articles/${candidate.id}/`
      }));

    return {
      params: { slug: article.id },
      props: { article, related }
    };
  });
}

const { article, related } = Astro.props;
const { Content } = await render(article);
---

<ArticleLayout
  title={article.data.title}
  seoTitle={article.data.seoTitle}
  description={article.data.description}
  primaryKeyword={article.data.primaryKeyword}
  pubDate={article.data.pubDate}
  updatedDate={article.data.updatedDate}
  author={article.data.author}
  category={article.data.category}
  keywords={article.data.keywords}
  sources={article.data.sources}
  related={related}
  image={article.data.heroImage}
  imageAlt={article.data.imageAlt}
  contentType={article.data.type}
>
  <Content />
</ArticleLayout>
