---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");

  return articles.map((article) => {
    const articleKeywords = new Set(
      article.data.keywords.map((keyword) =>
        keyword.toLowerCase().replace(/[^a-z0-9\s-]/g, " ").replace(/\s+/g, " ").trim()
      )
    );

    const related = articles
      .filter((candidate) => candidate.id !== article.id)
      .map((candidate) => {
        const candidateKeywords = candidate.data.keywords.map((keyword) =>
          keyword.toLowerCase().replace(/[^a-z0-9\s-]/g, " ").replace(/\s+/g, " ").trim()
        );
        const sharedKeywords = candidateKeywords.filter((keyword) => articleKeywords.has(keyword)).length;
        const sameCategory = candidate.data.category === article.data.category;

        const score =
          sharedKeywords * 10 +
          (sameCategory ? 8 : 0);

        return { candidate, score };
      })
      .filter(({ score }) => score > 0)
      .sort((a, b) =>
        b.score - a.score ||
        b.candidate.data.pubDate.valueOf() - a.candidate.data.pubDate.valueOf()
      )
      .slice(0, 3)
      .map(({ candidate }) => ({
        title: candidate.data.title,
        url: `/articles/${candidate.id}/`
      }));

    return {
      params: { slug: article.id },
      props: { article, related }
    };
  });
}

const { article, related } = Astro.props;
const { Content } = await render(article);
---

<ArticleLayout
  title={article.data.title}
  description={article.data.description}
  pubDate={article.data.pubDate}
  updatedDate={article.data.updatedDate}
  author={article.data.author}
  category={article.data.category}
  keywords={article.data.keywords}
  sources={article.data.sources}
  related={related}
  image={article.data.heroImage}
  imageAlt={article.data.imageAlt}
  contentType={article.data.type}
>
  <Content />
</ArticleLayout>
