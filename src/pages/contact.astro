---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact | Food Supply Crisis Report" description="Contact Food Supply Crisis Report for factual corrections, source suggestions and editorial enquiries."
  showAds={false}>
  <section class="section"><div class="shell">
    <p class="eyebrow">Contact</p>
    <h1>Contact Food Supply Crisis Report</h1>
    <p>For factual corrections, source suggestions or editorial enquiries, use the public GitHub issue channel below. This keeps correction requests connected to the publication's working record.</p>
    <p><a href="https://github.com/armanyaempire-sketch/foodsupplycrisis/issues/new" rel="noopener noreferrer" target="_blank">Open a correction or editorial enquiry</a></p>
    <h2>For corrections</h2>
    <p>Include the article URL, the specific claim that needs review, the reason it may be incorrect and a reliable source supporting the correction.</p>
    <h2>For source suggestions</h2>
    <p>Include the organization or research source, the relevant report or dataset and a direct link to the original material.</p>
  </div></section>
</BaseLayout>
