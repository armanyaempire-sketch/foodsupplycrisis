---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const countryArticles = (await getCollection("articles"))
  .filter((article) => article.data.category === "Countries")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Food Crisis by Country | Food Supply Crisis Report"
  description="Country-by-country food supply, food-price and food-security reporting with evidence, data and source links."
  noindex={countryArticles.length === 0}
>
  <section class="hero">
    <div class="shell">
      <p class="eyebrow">Country Watch</p>
      <h1>Food Supply & Food Crisis by Country</h1>
      <p>Country coverage will distinguish acute humanitarian food crises from food-price, crop, water and supply-chain risks.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      {countryArticles.length > 0 ? (
        <div class="card-grid">
          {countryArticles.map((article) => (
            <article class="card">
              <h2><a href={\`/articles/\${article.id}/\`}>{article.data.title}</a></h2>
              <p>{article.data.description}</p>
            </article>
          ))}
        </div>
      ) : (
        <div class="callout">
          Country pages are being researched and will be published with individual source links rather than thin templated summaries.
        </div>
      )}
    </div>
  </section>
</BaseLayout>
