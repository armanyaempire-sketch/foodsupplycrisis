---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";

const articles = (await getCollection("articles"))
  .filter((article) => article.data.category === "Food Shortages")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Food Shortages | Food Supply Crisis Report"
  description="Evidence-based reporting on localized food shortages, supply disruptions, availability risks and how to distinguish shortages from higher prices or temporary pressure."
>
  <section class="hero">
    <div class="shell">
      <p class="eyebrow">Topic Hub</p>
      <h1>Food Shortages</h1>
      <p>Understand where shortages are occurring, what is causing them, and how localized availability problems differ from broad food-price or global supply trends.</p>
    </div>
  </section>
  <section class="section">
    <div class="shell">
      <h2>Before calling it a shortage, ask five questions</h2>
      <p><strong>Which product?</strong> A shortage of one staple or input is not a shortage of all food. <strong>Where?</strong> A stock-out at one retailer may be a local distribution problem rather than a national supply failure. <strong>How long?</strong> A brief interruption is different from a persistent shortfall.</p>
      <p>Then ask what caused it and what official evidence is available. Crop estimates, stock disclosures, import data, market prices and humanitarian assessments each answer different questions. We distinguish physical unavailability from high prices and from households being unable to afford food that remains on sale.</p>
      <p>Wherever possible, our articles identify the affected location, product, time period and source instead of turning an isolated incident into a global claim.</p>
      {articles.length ? (
        <div class="card-grid">
          {articles.map((article) => <ArticleCard article={article} />)}
        </div>
      ) : (
        <div class="callout">
          <strong>Food-shortage coverage:</strong> New reporting will be added with source links and clear distinction between localized shortages, temporary disruptions and wider supply constraints.
        </div>
      )}
    </div>
  </section>
</BaseLayout>
