---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const articles = (await getCollection("articles"))
  .filter((article) => article.data.category === "Food Supply")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Food Supply 2026 | Food Supply Crisis Report" description="Follow grain, rice, stocks, imports, exports, production forecasts and supply-chain risks shaping the global food system.">
  <section class="hero"><div class="shell"><p class="eyebrow">Topic Hub</p><h1>Food Supply</h1><p>Production, stocks, imports, exports and supply-chain resilience across the global food system.</p></div></section>
  <section class="section"><div class="shell"><div class="card-grid">
    {articles.map((article) => (<article class="card"><h2><a href={`/articles/${article.id}/`}>{article.data.title}</a></h2><p>{article.data.description}</p></article>))}
  </div></div></section>
</BaseLayout>
